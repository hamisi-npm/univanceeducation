DIRECT_URL=

# Email (Resend) — required for /api/contact and /api/newsletter
RESEND_API_KEY=
EMAIL_FROM="Univance Education <noreply@univanceeducation.com>"
CONSULTATION_INBOX=consultation@univanceeducation.com

# Optional — salt for hashing client IPs stored on consultations
IP_HASH_SALT=
