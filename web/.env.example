# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SANITY_API_VERSION=2026-03-01
NEXT_PUBLIC_SANITY_STUDIO_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SANITY_API_READ_TOKEN=
SANITY_REVALIDATE_SECRET=
SANITY_PREVIEW_SECRET=

# PostgreSQL (Supabase)
# DATABASE_URL — transaction pooler (app runtime, :6543)
# DIRECT_URL — direct connection (Prisma migrate, :5432)
DATABASE_URL=
DIRECT_URL=

# Email (Resend) — required for /api/contact and /api/newsletter
RESEND_API_KEY=
EMAIL_FROM="Univance Education <noreply@univanceeducation.com>"
CONSULTATION_INBOX=consultation@univanceeducation.com

# Optional — salt for hashing client IPs stored on consultations
IP_HASH_SALT=

# Cloudflare Turnstile (consultation + newsletter forms)
# Create a widget: https://dash.cloudflare.com/ → Turnstile
# Local always-pass test keys (Cloudflare docs):
# TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upstash Redis (distributed rate limiting for /api/contact and /api/newsletter)
# https://console.upstash.com/ → Redis → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional: memory | unavailable
# Default: memory in development/test; unavailable (HTTP 503) in production when Redis fails
# RATE_LIMIT_REDIS_FAIL_MODE=
